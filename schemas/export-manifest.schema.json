{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "export-manifest",
  "type": "object",
  "properties": {
    "contract_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "source_repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s]+$"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_. /-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "data_kind": {
            "enum": [
              "source-items",
              "features",
              "feature-events",
              "experiments",
              "experiment-events",
              "assessments",
              "selected",
              "reports",
              "documentation",
              "schemas",
              "aliases",
              "legacy"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "data_kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "link_policy": {
      "const": "preserve-relative-allowlisted-or-immutable-source-url"
    },
    "collection_scope": {
      "type": "object",
      "properties": {
        "version": {
          "const": "dated-endpoints-v1"
        },
        "since": {
          "type": "string",
          "format": "date"
        },
        "cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "const": "Asia/Seoul"
        },
        "chrome_endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "baseline_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "current_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "baseline_committed_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "current_committed_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "baseline_revision",
              "current_revision"
            ],
            "additionalProperties": false
          }
        },
        "source_windows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string"
              },
              "since": {
                "type": "string",
                "format": "date"
              },
              "cutoff": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "source_id",
              "since",
              "cutoff"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "since",
        "cutoff",
        "timezone",
        "chrome_endpoints",
        "source_windows"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "source_repository",
    "source_ref",
    "source_commit",
    "files",
    "link_policy"
  ],
  "additionalProperties": false
}
