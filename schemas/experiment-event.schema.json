{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "experiment-event",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "experiment_kind": {
      "enum": [
        "flag_entry",
        "base_feature",
        "command_switch"
      ]
    },
    "event_type": {
      "enum": [
        "baseline",
        "added",
        "changed",
        "default_change",
        "expiry_change",
        "removed",
        "restored",
        "correction",
        "unknown"
      ]
    },
    "source_item_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "previous_source_revision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "before": {
      "properties": {
        "source_definition": {
          "$ref": "#/$defs/sourceDefinition"
        }
      }
    },
    "after": {
      "properties": {
        "source_definition": {
          "$ref": "#/$defs/sourceDefinition"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "verification_status": {
      "enum": [
        "source_only",
        "installed_observation",
        "behavior_verified"
      ]
    },
    "origin": {
      "enum": [
        "baseline",
        "backfill",
        "daily",
        "legacy"
      ]
    },
    "correction_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "temporal_scope": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "since": {
          "type": "string",
          "format": "date"
        },
        "cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "in_period",
            "before_period",
            "after_cutoff",
            "unchanged",
            "unknown",
            "context"
          ]
        },
        "basis": {
          "enum": [
            "publication",
            "item_change",
            "endpoint_comparison",
            "legacy_event",
            "unknown"
          ]
        },
        "evidence_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "day",
            "timestamp",
            "interval",
            "unknown"
          ]
        },
        "baseline_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "change": {
          "enum": [
            "added",
            "changed",
            "unchanged",
            "unknown",
            null
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "baseline_committed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_committed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "since",
        "cutoff",
        "status",
        "basis",
        "evidence_date",
        "precision",
        "baseline_revision",
        "current_revision",
        "change",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "experiment_id",
    "experiment_kind",
    "event_type",
    "source_item_ids",
    "source_revision",
    "previous_source_revision",
    "observed_at",
    "effective_at",
    "before",
    "after",
    "summary",
    "verification_status",
    "origin",
    "correction_of",
    "revision"
  ],
  "additionalProperties": false,
  "$defs": {
    "sourceDefinition": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "semantic_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_. /-]+$"
              },
              "expression": {
                "type": "string",
                "minLength": 1
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "symbol",
              "path",
              "expression"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "unresolved_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "version",
        "semantic_sha256",
        "expression",
        "options",
        "unresolved_references"
      ],
      "additionalProperties": false
    }
  }
}
