{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "browser": {
      "enum": [
        "chrome",
        "edge",
        "firefox",
        "safari",
        "brave",
        "whale",
        "opera",
        "vivaldi"
      ]
    },
    "canonical_key": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "source_item_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "lifecycle": {
      "enum": [
        "active",
        "removed",
        "unknown"
      ]
    },
    "legacy": {
      "type": "boolean"
    },
    "temporal_scope": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "since": {
          "type": "string",
          "format": "date"
        },
        "cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "in_period",
            "before_period",
            "after_cutoff",
            "unchanged",
            "unknown",
            "context"
          ]
        },
        "basis": {
          "enum": [
            "publication",
            "item_change",
            "endpoint_comparison",
            "legacy_event",
            "unknown"
          ]
        },
        "evidence_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "day",
            "timestamp",
            "interval",
            "unknown"
          ]
        },
        "baseline_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "change": {
          "enum": [
            "added",
            "changed",
            "unchanged",
            "unknown",
            null
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "baseline_committed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_committed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "since",
        "cutoff",
        "status",
        "basis",
        "evidence_date",
        "precision",
        "baseline_revision",
        "current_revision",
        "change",
        "reason"
      ],
      "additionalProperties": false
    },
    "source_revision_ids": {
      "description": "Confirmed source revisions per cited item, oldest first. Older records can omit pins.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "source_revision_excerpts": {
      "description": "Feature-specific passages verified against the indicated source revision during classification.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200,
        "pattern": "\\S"
      }
    }
  },
  "required": [
    "schema_version",
    "feature_id",
    "browser",
    "canonical_key",
    "title",
    "aliases",
    "source_item_ids",
    "event_ids",
    "lifecycle",
    "legacy"
  ],
  "additionalProperties": false
}
