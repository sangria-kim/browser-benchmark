{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source-item",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source_item_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "browser": {
      "enum": [
        "chrome",
        "edge",
        "firefox",
        "safari",
        "brave",
        "whale",
        "opera",
        "vivaldi"
      ]
    },
    "item_key": {
      "type": "string",
      "minLength": 1
    },
    "item_type": {
      "enum": [
        "feature",
        "change",
        "fix",
        "security",
        "general",
        "flag_entry",
        "base_feature",
        "command_switch",
        "unknown"
      ]
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1200
        },
        {
          "type": "null"
        }
      ]
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s]+$"
        },
        "section": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "excerpt": {
          "type": "string",
          "maxLength": 1200
        }
      },
      "required": [
        "url",
        "section",
        "source_revision",
        "content_sha256",
        "observed_at",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "record_status": {
      "enum": [
        "parsed",
        "unparsed",
        "legacy",
        "reference"
      ]
    },
    "origin": {
      "enum": [
        "baseline",
        "backfill",
        "daily",
        "legacy",
        "reference"
      ]
    },
    "lifecycle": {
      "enum": [
        "active",
        "removed",
        "unknown"
      ]
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "revision_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_revision": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1200
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^\\s]+$"
              },
              "section": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_revision": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "excerpt": {
                "type": "string",
                "maxLength": 1200
              }
            },
            "required": [
              "url",
              "section",
              "source_revision",
              "content_sha256",
              "observed_at",
              "excerpt"
            ],
            "additionalProperties": false
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "channel": {
            "$ref": "#/properties/channel"
          },
          "platform": {
            "$ref": "#/properties/platform"
          },
          "version": {
            "$ref": "#/properties/version"
          },
          "item_type": {
            "$ref": "#/properties/item_type"
          },
          "record_status": {
            "$ref": "#/properties/record_status"
          },
          "lifecycle": {
            "$ref": "#/properties/lifecycle"
          },
          "item_content_sha256": {
            "$ref": "#/properties/item_content_sha256"
          },
          "restores_revision_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "description": "Existing evidence revision whose complete old-head facts this append-only snapshot restores. This is not a new observation."
          }
        },
        "required": [
          "revision_id",
          "content_sha256",
          "source_revision",
          "title",
          "summary",
          "evidence",
          "published_at",
          "observed_at"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "experiment_kind": {
      "anyOf": [
        {
          "enum": [
            "flag_entry",
            "base_feature",
            "command_switch"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "source_location": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_symbol": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "item_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash of the complete parsed browser item text and section, before public excerpt truncation. The evidence hash still identifies the raw document."
    },
    "temporal_scope": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "since": {
          "type": "string",
          "format": "date"
        },
        "cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "in_period",
            "before_period",
            "after_cutoff",
            "unchanged",
            "unknown",
            "context"
          ]
        },
        "basis": {
          "enum": [
            "publication",
            "item_change",
            "endpoint_comparison",
            "legacy_event",
            "unknown"
          ]
        },
        "evidence_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "day",
            "timestamp",
            "interval",
            "unknown"
          ]
        },
        "baseline_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "change": {
          "enum": [
            "added",
            "changed",
            "unchanged",
            "unknown",
            null
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "baseline_committed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_committed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "since",
        "cutoff",
        "status",
        "basis",
        "evidence_date",
        "precision",
        "baseline_revision",
        "current_revision",
        "change",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "source_item_id",
    "source_id",
    "browser",
    "item_key",
    "item_type",
    "title",
    "summary",
    "channel",
    "platform",
    "version",
    "published_at",
    "observed_at",
    "evidence",
    "record_status",
    "origin",
    "lifecycle",
    "revisions",
    "experiment_kind",
    "source_location",
    "source_symbol"
  ],
  "additionalProperties": false
}
