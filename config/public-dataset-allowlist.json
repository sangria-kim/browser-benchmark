{
  "contract_version": "1.0",
  "default_ref": "main",
  "catalog": {
    "path": "data/catalog/features/catalog.json",
    "id_field": "feature_id"
  },
  "evidence": {
    "path_glob": "data/source-items/*/*.json",
    "id_field": "source_item_id",
    "referenced_by": "source_item_ids",
    "selection": "referenced_only",
    "revisions_field": "revisions",
    "revision_id_field": "revision_id",
    "feature_revision_ids_by_source": "source_revision_ids",
    "current_revision": "last_linked_revision",
    "feature_excerpt_by_revision": "source_revision_excerpts",
    "excerpt_path": ["evidence", "excerpt"],
    "when_unpinned": "source_item_at_pinned_commit"
  },
  "daily_status": {
    "path_glob": "data/daily-status/*.json",
    "timezone": "Asia/Seoul",
    "cutoff_local_time": "07:00:00",
    "historical_cutoff_local_times": ["08:00:00"]
  },
  "browser_status": {
    "path_glob": "data/browser-status/*/*.json",
    "modes": ["daily", "weekly_reconcile"],
    "version": 1
  },
  "weekly_status": {
    "path_glob": "data/weekly-status/*.json",
    "counted_from": "2026-11-29T10:00:00+09:00",
    "version": 1
  }
}
